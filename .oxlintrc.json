{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	// Generated and vendored code, kept in sync by hand with `ignorePatterns` in
	// `.oxfmtrc.json`: the linter and the formatter skip the same files.
	"ignorePatterns": [
		"**/node_modules/",
		"**/dist/",
		"**/build/",
		"**/out/",
		"**/coverage/",
		"**/.turbo/",
		"**/*.tsbuildinfo",
		"pnpm-lock.yaml",
		"apps/api/prisma/migrations/",
		"apps/api/src/generated/",
		// Committed agent skill.
		".agents/"
	],
	"rules": {
		"no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
		"typescript/no-explicit-any": "error"
	},
	"overrides": [
		{
			// Only outside the API: Nest's `emitDecoratorMetadata` turns a
			// constructor parameter's class into a *value* import, so `import type`
			// there would erase the very reference dependency injection needs.
			"files": ["apps/web/**/*.{ts,tsx}", "packages/**/*.ts"],
			"rules": {
				"typescript/consistent-type-imports": [
					"error",
					{ "prefer": "type-imports", "fixStyle": "inline-type-imports" }
				]
			}
		},
		{
			"files": ["apps/api/**/*.ts"],
			"env": { "node": true }
		},
		{
			// The shared package runs in the browser and in Node, so it may name neither
			// runtime: no `node:*`, no DOM. A rule nothing executes is not a rule, so the
			// constraint lives here rather than in AGENTS.md.
			"files": ["packages/**/*.ts"],
			"rules": {
				"no-restricted-globals": [
					"error",
					{ "name": "window", "message": "@lumo/shared must stay runtime-agnostic: no DOM." },
					{ "name": "document", "message": "@lumo/shared must stay runtime-agnostic: no DOM." },
					{ "name": "localStorage", "message": "@lumo/shared must stay runtime-agnostic: no DOM." }
				],
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": ["node:*"],
								"message": "@lumo/shared must stay runtime-agnostic: no node:* imports."
							}
						]
					}
				]
			}
		},
		{
			"files": ["apps/web/src/**/*.{ts,tsx}"],
			"env": { "browser": true }
		},
		{
			"files": ["apps/web/*.config.ts"],
			"env": { "node": true }
		}
	]
}
