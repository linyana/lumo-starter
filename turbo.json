{
	"$schema": "https://turbo.build/schema.json",
	"ui": "stream",
	"globalEnv": ["NODE_ENV"],
	"globalDependencies": [".oxlintrc.json", ".oxfmtrc.json", "tsconfig.base.json"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "!.vite", "!.turbo", "!node_modules"]
		},
		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		},
		"@lumo/shared#dev": {
			"dependsOn": ["build"],
			"cache": false,
			"persistent": true
		},
		"typecheck": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"lint": {
			"outputs": []
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": []
		}
	}
}
