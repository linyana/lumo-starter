{
	"name": "@lumo/shared",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsup --clean",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint"
	},
	"peerDependencies": {
		"zod": "^4.6.0"
	},
	"devDependencies": {
		"tsup": "^8.5.0",
		"typescript": "catalog:",
		"zod": "catalog:"
	}
}
