// Prisma 7: the connection URL lives in prisma.config.ts, not in the schema.
// The generator emits plain TypeScript into src/generated/prisma, and
// `moduleFormat = "cjs"` makes it use `__dirname` instead of `import.meta.url`
// so Nest's CommonJS build can require it.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  // The API is ESM (Nest 12 is ESM-only), so the generated client must use
  // `import.meta.url` rather than `__dirname`.
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(254)
  name         String   @db.VarChar(80)
  passwordHash String
  // Stored as text on purpose: valid values are enforced by the shared zod
  // constants, and adding a role must not require a database migration.
  roles        String[] @default(["MEMBER"])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?   @db.Uuid
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
