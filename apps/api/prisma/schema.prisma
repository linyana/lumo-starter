generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  runtime         = "nodejs"
  previewFeatures = ["postgresqlExtensions"]
  moduleFormat    = "esm"
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

model Account {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(254)
  username     String   @unique @db.VarChar(32)
  name         String   @db.VarChar(80)
  passwordHash String
  roles        String[] @default(["MEMBER"])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  settings      Setting[]

  @@index([email(ops: raw("gin_trgm_ops")), username(ops: raw("gin_trgm_ops")), name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("accounts")
}

model Setting {
  id      String @id @default(uuid()) @db.Uuid
  type    String @db.VarChar(32)
  ownerId String @db.Uuid
  content Json   @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner Account @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([type, ownerId])
  @@map("settings")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique
  accountId  String    @db.Uuid
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?   @db.Uuid
  createdAt  DateTime  @default(now())

  @@index([accountId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
