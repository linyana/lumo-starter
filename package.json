{
	"name": "lumo-starter",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": ">=24.0.0",
		"pnpm": ">=12.0.0"
	},
	"scripts": {
		"dev": "turbo run dev",
		"postinstall": "pnpm --filter @lumo/shared build",
		"build": "turbo run build",
		"lint": "turbo run lint",
		"typecheck": "turbo run typecheck",
		"check": "pnpm format:check && pnpm lint && pnpm typecheck",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"db:up": "docker compose up -d --wait postgres",
		"db:down": "docker compose down",
		"db:reset": "docker compose down -v && docker compose up -d --wait postgres",
		"db:migrate": "pnpm --filter @lumo/api db:migrate",
		"db:generate": "pnpm --filter @lumo/api db:generate",
		"db:seed": "pnpm --filter @lumo/api db:seed",
		"db:studio": "pnpm --filter @lumo/api db:studio"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"oxfmt": "^0.76.0",
		"oxlint": "^1.91.0",
		"turbo": "^2.11.10",
		"typescript": "catalog:"
	}
}
