{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 2,
	"singleQuote": true,
	"printWidth": 100,
	"semi": true,
	"trailingComma": "all",
	"endOfLine": "lf",
	"arrowParens": "always",
	// Reordering a package.json is not a formatting decision this repo makes.
	"sortPackageJson": false,
	"ignorePatterns": [
		"**/node_modules/",
		"**/dist/",
		"**/build/",
		"**/out/",
		"**/coverage/",
		"**/.turbo/",
		"**/*.tsbuildinfo",
		"pnpm-lock.yaml",
		"apps/api/prisma/migrations/",
		"apps/api/src/generated/"
	]
}
